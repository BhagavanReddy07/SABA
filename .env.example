# --- Storage ---
# Local dev (matches docker-compose.yml):
DATABASE_URL=postgresql://saba:saba_password@localhost:5432/saba
# Deploying? Use a free hosted Postgres instead (Neon: https://neon.tech) —
# paste its pooled connection string, e.g.
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/saba?sslmode=require
# `npm run db:init` also enables pgvector there (Neon supports it).

# Optional Tier-1 cache. Leave unset on free hosting (Postgres fallback kicks in),
# or use a free Upstash Redis URL (https://upstash.com).
REDIS_URL=redis://localhost:6380

# --- Auth ---
# Any long random string. Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_long_random_secret

# --- AI (need at least one chat provider — without any SABA runs in demo mode) ---
# Groq (recommended for chat — fast, generous free tier). https://console.groq.com/keys
GROQ_API_KEY=
# Gemini — chat fallback, image understanding, and Tier 3 embeddings. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model chains when a provider retires a model (comma-separated, tried in order).
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-flash-latest
# Optional local/private mode with Ollama (https://ollama.com): chat + embeddings stay on your machine.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.1
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Semantic memory (Tier 3) ---
# Pinecone (https://app.pinecone.io). Without it, Tier 3 uses pgvector in your Postgres
# when available; without either, semantic recall is skipped.
PINECONE_API_KEY=
PINECONE_INDEX=saba-memory

# --- Live web search for the lookup tool (optional — one is enough) ---
# TAVILY_API_KEY=   # https://tavily.com (free tier)
# BRAVE_API_KEY=    # https://brave.com/search/api (free tier)

# --- Email: reminders, morning brief, verification, password reset (optional) ---
# Brevo free tier: 300 emails/day, no credit card. https://app.brevo.com
# 1. Sign up, verify the sender email you'll send FROM (Settings → Senders).
# 2. Get an API key from Settings → SMTP & API → API Keys.
BREVO_API_KEY=
BREVO_FROM=you@example.com
# Shared secret protecting /api/cron/reminders — any long random string.
# An external free cron (https://cron-job.org) calls that URL every 5 minutes; it delivers
# reminders, sends morning briefs and runs nightly memory consolidation.
CRON_SECRET=replace_with_another_long_random_secret

# --- Google sign-in + Google Calendar (OAuth 2.0 Web client from console.cloud.google.com) ---
# Authorized redirect URI: <your origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram (optional) — talk to SABA and get reminders in Telegram ---
# Create a bot with @BotFather, paste its token, deploy, then open
# <your origin>/api/telegram/setup?key=<CRON_SECRET> once to register the webhook.
# TELEGRAM_BOT_TOKEN=

# --- Web push notifications (optional) — generate with `npm run vapid` ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- SABA Bench (optional, local) — lets `npm run eval` switch memory tiers per request ---
# EVAL_KEY=any_random_string_of_16+_chars
